# Arc Testnet only. Use a test wallet funded from faucet.circle.com.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# A second independently operated provider; do not repeat the primary URL.
ARC_TESTNET_RPC_FALLBACK_URL=
DEPLOYER_PRIVATE_KEY=
# Protocol owner must differ from deployer. Prefer hardware wallet / verified Safe.
PROTOCOL_OWNER_ADDRESS=
# Optional local testnet convenience for register/seed. Production owner stays in hardware.
OWNER_PRIVATE_KEY=
# Leave blank to deploy a DemoVault backed by Arc Testnet faucet USDC.
TESTNET_VAULT_ADDRESS=
# Leave blank to deploy our testnet-only wrapper around the real Uniswap v4 core.
# Set an existing manager only after independently verifying its code and network.
UNISWAP_V4_POOL_MANAGER_ADDRESS=
# Optional verified V4Quoter on the same chain and PoolManager; persisted in manifest.
UNISWAP_V4_QUOTER_ADDRESS=
# Explicit PT price in USDC for demo pool initialization (not an APY).
PT_PRICE_USDC=0.99
# Maximum USDC and PT supplied per series by seed:testnet (human token units).
POOL_SEED_USDC=10
POOL_SEED_PT=10
# One-hour, one-day and seven-day series. Set custom durations in seconds if needed.
SERIES_DURATIONS=3600,86400,604800

# Dedicated keeper wallet: never reuse DEPLOYER_PRIVATE_KEY. Fund its gas balance.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_INTERVAL_SECONDS=10
KEEPER_CONFIRMATIONS=2
KEEPER_MAX_BLOCK_AGE_SECONDS=120
KEEPER_PENDING_ALERT_SECONDS=120
KEEPER_MAX_GAS_PRICE_GWEI=250
KEEPER_GAS_LIMIT_CAP=500000
# Native gas USDC uses 18 decimals; this is a warning threshold, not a stop threshold.
KEEPER_MIN_GAS_BALANCE=0.1
KEEPER_STATE_FILE=runtime/keeper-state.json
# Configure ONE destination locally; tokens are never logged or sent to the browser.
KEEPER_ALERT_WEBHOOK_URL=
KEEPER_TELEGRAM_BOT_TOKEN=
KEEPER_TELEGRAM_CHAT_ID=
KEEPER_ALERT_STATE_FILE=runtime/keeper-alerts.json

# Agent/MCP: bind one deployed Tijori and use its separate, owner-authorized agent key.
# Leave AGENT_PRIVATE_KEY empty for read-only use. Never use the owner/deployer key.
AGENT_TIJORI_ADDRESS=
AGENT_PRIVATE_KEY=
# Alternative to AGENT_PRIVATE_KEY: a JSON file with a privateKey field (written by agent:connect).
AGENT_KEY_FILE=
AGENT_STATE_FILE=runtime/agent-state.json
AGENT_SLIPPAGE_BPS=50
AGENT_PLAN_TTL_SECONDS=300
AGENT_CONFIRMATIONS=2
AGENT_MAX_GAS_PRICE_GWEI=250
AGENT_GAS_LIMIT_CAP=1500000

# Local read-only app + quote service; public binding is deliberately rejected.
API_PORT=4173
# Verified real-vault fork inputs. A factory/Morpho core address is not a vault.
FORK_RPC_URL=
FORK_VAULT_ADDRESS=
FORK_BLOCK_NUMBER=
# Attached Arc-aware local fork; public URLs are rejected for all fork-test writes.
FORK_LOCAL_RPC_URL=http://127.0.0.1:8545
