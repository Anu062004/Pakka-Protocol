[Unit]
Description=Pakka Arc Testnet expiry keeper
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pakka
WorkingDirectory=/opt/pakka
ExecStart=/usr/bin/node --env-file=/opt/pakka/.env.keeper scripts/keeper-testnet.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pakka/runtime

[Install]
WantedBy=multi-user.target
