{
  "name": "pakka-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "deploy:testnet": "node --env-file-if-exists=.env scripts/deploy-testnet.ts",
    "seed:testnet": "node --env-file-if-exists=.env scripts/seed-testnet.ts",
    "keeper:testnet": "node --env-file-if-exists=.env scripts/keeper-testnet.ts",
    "keeper:once": "node --env-file-if-exists=.env scripts/keeper-testnet.ts --once",
    "keeper:health": "node --env-file-if-exists=.env scripts/keeper-testnet.ts --health",
    "deploy:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env scripts/deploy-testnet.ts",
    "register:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env scripts/register-testnet.ts",
    "seed:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env scripts/seed-testnet.ts",
    "add:series:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env scripts/add-series.ts",
    "keeper:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env scripts/keeper-testnet.ts",
    "dev:mainnet": "PAKKA_NETWORK=mainnet node --env-file-if-exists=.env backend/server.ts",
    "agent:mcp": "node --env-file-if-exists=.env agent/mcp-server.ts",
    "agent:http": "node --env-file-if-exists=.env agent/http-server.ts",
    "agent:setup": "node --env-file-if-exists=.env scripts/agent-cli.ts",
    "agent:connect": "node --env-file-if-exists=.env scripts/agent-cli.ts connect",
    "register:testnet": "node --env-file-if-exists=.env scripts/register-testnet.ts",
    "add:series": "node --env-file-if-exists=.env scripts/add-series.ts",
    "dev": "node --env-file-if-exists=.env backend/server.ts",
    "setup:env": "node scripts/setup-env.ts",
    "test:system": "node --test test/security-hardening.test.ts",
    "test:browser": "node --test test/browser-e2e.ts",
    "test:fork": "node --env-file-if-exists=.env scripts/fork-e2e.ts",
    "security": "node --env-file-if-exists=.env scripts/security-check.ts",
    "security:status": "node scripts/security-check.ts --status",
    "typecheck": "tsc --noEmit",
    "package:build": "node scripts/build-package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openzeppelin/contracts": "file:vendor/openzeppelin-contracts",
    "ethers": "6.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "hardhat": "2.29.1",
    "solc": "0.8.26",
    "typescript": "^7.0.2"
  }
}
